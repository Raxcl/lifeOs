{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "时光手帐",
  "version": "0.1.42",
  "identifier": "com.lifeos.morning-journal",
  "build": {
    "frontendDist": "../app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "时光手帐",
        "width": 1320,
        "height": 900,
        "minWidth": 980,
        "minHeight": 720,
        "backgroundColor": "#f3f6f1",
        "resizable": true,
        "decorations": false,
        "visible": false,
        "maximized": false,
        "dragDropEnabled": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "externalBin": [
      "binaries/syncthing"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}
