{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "LifeOS Morning Journal",
  "version": "0.1.0",
  "identifier": "com.lifeos.morning-journal",
  "build": {
    "frontendDist": "../app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "LifeOS 晨间日记",
        "width": 1320,
        "height": 900,
        "minWidth": 980,
        "minHeight": 720,
        "backgroundColor": "#f3f6f1",
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
